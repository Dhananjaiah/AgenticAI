# Environment Configuration
# Copy this file to .env and configure values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://claims_user:claims_password@localhost:5432/claims_db
DATABASE_URL_SYNC=postgresql+psycopg2://claims_user:claims_password@localhost:5432/claims_db
METADATA_DATABASE_URL=postgresql+asyncpg://claims_user:claims_password@localhost:5432/claims_metadata_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CLAIMS=claims-events
KAFKA_TOPIC_INDEXING=indexing-events
KAFKA_CONSUMER_GROUP=claims-processor

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# LLM Mode: "azure", "openai", or "stub"
LLM_MODE=stub

# Vector DB Configuration
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=claims_documents

# OCR Configuration
# OCR_ENGINE: "tesseract" or "azure_form_recognizer"
OCR_ENGINE=tesseract
TESSERACT_CMD=/usr/bin/tesseract
AZURE_FORM_RECOGNIZER_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_FORM_RECOGNIZER_KEY=your-key-here

# SharePoint Configuration (for production)
SHAREPOINT_TENANT_ID=your-tenant-id
SHAREPOINT_CLIENT_ID=your-client-id
SHAREPOINT_CLIENT_SECRET=your-client-secret
SHAREPOINT_SITE_URL=https://your-org.sharepoint.com/sites/claims

# Azure Blob Storage Configuration
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;...
AZURE_BLOB_CONTAINER_NAME=claims-documents

# AWS S3 Configuration (alternative to Azure Blob)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=claims-documents

# Local Data Paths (for development simulation)
LOCAL_SHAREPOINT_PATH=./data/sharepoint
LOCAL_BLOB_PATH=./data/blobs

# API Security
API_KEY_SECRET=your-super-secret-api-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentic-ai-claims
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Deduplication Configuration
DEDUPE_SIMILARITY_THRESHOLD=0.85
DEDUPE_EXACT_MATCH_FIELDS=claim_id,policy_id

# RAG Configuration
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
